# ==========================================================================
# Keyword Suggest & Intent Analyzer — environment
#
# Copy this file to `.env` and fill in the placeholders. Everything the
# service does is configured here; nothing below requires a code change.
#
#     cp .env.example .env
#
# The only two values you MUST set to run locally are ADMIN_PASSWORD and
# GEMINI_API_KEY. Every other line already has a working default.
# ==========================================================================

# ---- Mode ----------------------------------------------------------------

# `dev` or `prod`. dev serves the frontend at /, allows any localhost origin,
# does not enforce API_KEY, enables /docs, and logs verbosely.
# prod restricts CORS to ALLOWED_ORIGINS, enforces API_KEY for external
# callers, disables /docs, and logs concisely.
MODE=dev

# ---- Access --------------------------------------------------------------

# The single admin login. There are no other accounts.
ADMIN_USERNAME=admin

# REQUIRED — no default. Startup fails without it. Use a long random string.
ADMIN_PASSWORD=change-me-to-a-long-random-password

# How long a session token stays valid after login.
SESSION_TTL_HOURS=12

# REQUIRED WHEN MODE=prod. Keeps casual external callers off the API; it is
# not a secret once the browser has it (see README). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# REQUIRED WHEN MODE=prod. Comma-separated origins allowed to call the API,
# e.g. https://keyword-analyzer.onrender.com . Leave empty in dev.
ALLOWED_ORIGINS=

# ---- AI ------------------------------------------------------------------

# REQUIRED — no default. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Model used for the intent report. Change this line to switch models — the
# code never names a model. (gemini-2.5-flash is being retired; do not use it.)
GEMINI_MODEL=gemini-3.5-flash

# Per-call timeout for the model, in seconds.
GEMINI_TIMEOUT_SECONDS=120

# Cap on how many keywords are sent in the prompt; the rest are truncated
# and the prompt says so.
MAX_KEYWORDS_IN_PROMPT=600

# ---- Collection ----------------------------------------------------------

# Google autocomplete `hl` (interface language).
SUGGEST_LANG=en

# Google autocomplete `gl` (country / market).
SUGGEST_COUNTRY=us

# Delay between consecutive autocomplete requests, in seconds. Requests are
# always sequential, never concurrent; small random jitter is added on top.
SUGGEST_DELAY_SECONDS=1.0

# Per-request timeout, in seconds.
SUGGEST_TIMEOUT_SECONDS=5.0

# Retries per query on timeout / 429 / 5xx, with exponential backoff.
SUGGEST_MAX_RETRIES=2

# Question-intent modifiers, prefixed to the seed topic. Comma-separated.
SUGGEST_QUESTION_MODIFIERS=who,what,when,where,why,how

# Commercial-intent modifiers. "near me" is appended; the rest are prefixed.
SUGGEST_COMMERCIAL_MODIFIERS=best,buy,cheap,near me

# ---- Limits and logging --------------------------------------------------

# Global search quota (shared across the whole app, not per IP).
RATE_LIMIT_MAX_SEARCHES=10
RATE_LIMIT_WINDOW_MINUTES=60

# How long a completed run is reused from cache. 1440 = 24 hours.
CACHE_TTL_MINUTES=1440

# Maximum cached runs before least-recently-used entries are evicted.
CACHE_MAX_ENTRIES=50

# DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
