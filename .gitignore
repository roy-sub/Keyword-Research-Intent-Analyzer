# ---- Secrets -------------------------------------------------------------
# Never commit a real .env. The checked-in template is backend/.env.example.
.env
.env.*
!.env.example
!backend/.env.example
backend/.env
frontend/.env

# The frontend's config.js is regenerated by frontend/build.sh on every
# deploy. The committed copy is the local-development default, so it IS
# tracked — do not add it here.

# ---- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# ---- Node (only if a build step is ever added to the frontend) -----------
node_modules/

# ---- Archives and OS junk ------------------------------------------------
*.zip
.DS_Store
Thumbs.db

# ---- Editors -------------------------------------------------------------
.idea/
.vscode/
*.swp
