# ==========================================================================
# Keyword Suggest & Intent Analyzer — environment
#
# Copy this file to `.env` and fill in the placeholders. Everything the
# service does is configured here; nothing below requires a code change.
#
#     cp .env.example .env
#
# The only two things you MUST set to run locally are ADMIN_PASSWORD and at
# least one AI provider key. Every other line already has a working default.
# ==========================================================================

# ---- Mode ----------------------------------------------------------------

# `dev` or `prod`. dev allows ANY origin (so the frontend works whether you
# open it at localhost, 127.0.0.1, 0.0.0.0 or a LAN IP), does not enforce
# API_KEY, enables /docs, and logs verbosely. prod restricts CORS to
# ALLOWED_ORIGINS exactly, enforces API_KEY for callers outside it, disables
# /docs, and logs concisely.
MODE=dev

# ---- Access --------------------------------------------------------------

# The single admin login. There are no other accounts.
ADMIN_USERNAME=admin

# REQUIRED — no default. Startup fails without it. Use a long random string.
ADMIN_PASSWORD=change-me-to-a-long-random-password

# How long a session token stays valid after login.
SESSION_TTL_HOURS=12

# REQUIRED WHEN MODE=prod. Keeps casual external callers off the API; it is
# not a secret once the browser has it (see README). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# REQUIRED WHEN MODE=prod. Comma-separated origins allowed to call the API —
# in practice the frontend service's URL, e.g.
# https://keyword-analyzer-web.onrender.com
# A bare hostname is accepted and promoted to https://<host>.
# Leave empty in dev: every origin is allowed there.
ALLOWED_ORIGINS=

# ---- AI ------------------------------------------------------------------
#
# Three providers, tried in order. The first that returns a report wins; any
# failure (no key, rejected key, exhausted balance, rate limit, timeout,
# server error, empty or declined response) falls through to the next.
#
# AT LEAST ONE key is required — startup fails if all three are empty.
# Set as many as you want: an unset provider is skipped, not an error.

# Order to try. Default is Claude, then OpenAI, then Gemini.
AI_PROVIDER_ORDER=anthropic,openai,gemini

# Per-provider timeout, in seconds. Applies to each attempt separately.
AI_TIMEOUT_SECONDS=120

# Cap on how many keywords are sent in the prompt; the rest are truncated
# and the prompt says so.
MAX_KEYWORDS_IN_PROMPT=600

# ---- Claude (tried first) ----
# Key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Balanced tier. Stronger: claude-opus-5. Cheaper: claude-haiku-4-5
ANTHROPIC_MODEL=claude-sonnet-5

# ---- OpenAI (tried second) ----
# Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
# Compact tier, 400K context. Stronger: gpt-5.4, gpt-6-astra
OPENAI_MODEL=gpt-5.4-mini

# ---- Gemini (tried last) ----
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Most capable Flash model. gemini-2.5-flash is retiring; do not use it.
GEMINI_MODEL=gemini-3.8-flash

# ---- Markets -------------------------------------------------------------

# Which locales the team can choose between in the UI. A market is a language,
# a country AND the question and buying words that suit them — changing `hl`
# without changing those words would fire English questions at German
# searches and quietly waste ten of the 37 queries. Defined in
# backend/app/markets.py; known codes: en-US, de-CH, de-DE, en-GB.
ENABLED_MARKETS=en-US,de-CH

# Which of the above is preselected. Anyone can switch in the UI per run.
DEFAULT_MARKET=en-US

# ---- Collection ----------------------------------------------------------

# Delay between consecutive autocomplete requests, in seconds. Requests are
# always sequential, never concurrent; small random jitter is added on top.
SUGGEST_DELAY_SECONDS=1.0

# Per-request timeout, in seconds.
SUGGEST_TIMEOUT_SECONDS=5.0

# Retries per query on timeout / 429 / 5xx, with exponential backoff.
SUGGEST_MAX_RETRIES=2

# ---- Limits and logging --------------------------------------------------

# Global search quota (shared across the whole app, not per IP).
RATE_LIMIT_MAX_SEARCHES=10
RATE_LIMIT_WINDOW_MINUTES=60

# How long a completed run is reused from cache. 1440 = 24 hours.
CACHE_TTL_MINUTES=1440

# Maximum cached runs before least-recently-used entries are evicted.
CACHE_MAX_ENTRIES=50

# DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
